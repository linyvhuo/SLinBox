/* Technology Theme - 科技主题 */
QMainWindow {
    background-color: #0a0e27;
}

QWidget {
    background-color: #0a0e27;
    color: #00d4ff;
}

QTabWidget::pane {
    border: 1px solid #1a1f3a;
    background: #1a1f3a;
    border-radius: 3px;
}

QTabBar::tab {
    background: #0a0e27;
    color: #00d4ff;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:selected {
    background: #1a1f3a;
    border-bottom: 2px solid #00d4ff;
}

QTabBar::tab:hover:!selected {
    background: #1a1f3a;
    color: #00ffff;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00d4ff, stop:1 #0099cc);
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 3px;
    font-weight: bold;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ffff, stop:1 #00d4ff);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0099cc, stop:1 #006699);
}

QPushButton:disabled {
    background: #1a1f3a;
    color: #5d6d7e;
}

QComboBox {
    background-color: #1a1f3a;
    color: #00d4ff;
    border: 1px solid #00d4ff;
    padding: 4px;
    border-radius: 3px;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid #00ffff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(:/icons/down_arrow_tech.png);
}

QTextEdit, QLineEdit, QPlainTextEdit {
    background-color: #1a1f3a;
    color: #00d4ff;
    border: 1px solid #00d4ff;
    padding: 4px;
    border-radius: 3px;
}

QTextEdit:focus, QLineEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #00ffff;
}

QLabel {
    color: #00d4ff;
}

QGroupBox {
    border: 1px solid #00d4ff;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: #00d4ff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QCheckBox, QRadioButton {
    spacing: 5px;
    color: #00d4ff;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:checked {
    image: url(:/icons/checkbox_checked_tech.png);
}

QCheckBox::indicator:unchecked {
    image: url(:/icons/checkbox_unchecked_tech.png);
}

QProgressBar {
    border: 2px solid #00d4ff;
    border-radius: 5px;
    text-align: center;
    background-color: #0a0e27;
    color: #00d4ff;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00d4ff, stop:1 #00ff88);
    border-radius: 3px;
}

QScrollBar:vertical {
    border: none;
    background: #0a0e27;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1a1f3a;
    border: 1px solid #00d4ff;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #00d4ff;
    border: 1px solid #00ffff;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #0a0e27;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #1a1f3a;
    border: 1px solid #00d4ff;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #00d4ff;
    border: 1px solid #00ffff;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QTableWidget {
    background-color: #1a1f3a;
    border: 1px solid #00d4ff;
    gridline-color: #0a0e27;
    color: #00d4ff;
    selection-background-color: #00d4ff;
    selection-color: #0a0e27;
}

QTableWidget::item {
    padding: 4px;
}

QTableWidget::item:selected {
    background-color: #00d4ff;
    color: #0a0e27;
}

QHeaderView::section {
    background-color: #0a0e27;
    color: #00d4ff;
    padding: 4px;
    border: 1px solid #00d4ff;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #1a1f3a;
}

QSpinBox, QDoubleSpinBox {
    background-color: #1a1f3a;
    color: #00d4ff;
    border: 1px solid #00d4ff;
    padding: 4px;
    border-radius: 3px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00ffff;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #00d4ff;
    border-top-right-radius: 3px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #00d4ff;
    border-bottom-right-radius: 3px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #00d4ff;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #0a0e27;
    border: 1px solid #00d4ff;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00d4ff, stop:1 #00ff88);
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    border: 1px solid #00ffff;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00ffff, stop:1 #00d4ff);
}

QMenu {
    background-color: #1a1f3a;
    border: 1px solid #00d4ff;
    border-radius: 3px;
    color: #00d4ff;
}

QMenu::item {
    padding: 6px 20px;
}

QMenu::item:selected {
    background-color: #00d4ff;
    color: #0a0e27;
}

QMenuBar {
    background-color: #0a0e27;
    border-bottom: 1px solid #00d4ff;
    color: #00d4ff;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #00d4ff;
    color: #0a0e27;
    border-radius: 3px;
}

QStatusBar {
    background-color: #0a0e27;
    border-top: 1px solid #00d4ff;
    color: #00d4ff;
}

QToolBar {
    background-color: #0a0e27;
    border: 1px solid #00d4ff;
    spacing: 3px;
}

QToolButton {
    background-color: transparent;
    border: none;
    padding: 4px;
    border-radius: 3px;
    color: #00d4ff;
}

QToolButton:hover {
    background-color: #00d4ff;
    color: #0a0e27;
}

QToolButton:pressed {
    background-color: #0099cc;
}